{
  "files.associations": {
    "*.gs": "javascript",
    "appsscript.json": "jsonc"
  },
  "files.exclude": {
    "node_modules": true,
    "**/.tmp_*": true
  },
  "javascript.format.enable": true,
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  }
}
